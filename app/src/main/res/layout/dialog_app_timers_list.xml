<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Permissions banner if needed -->
    <LinearLayout
        android:id="@+id/layoutPermissionsNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/rounded_rect_shade_color"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvPermissionWarning"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Permissions required for floating timer"
            android:textColor="?attr/primaryColor"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnGrantOverlay"
            style="@style/TextSmallBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Grant Overlay Permission"
            android:textColor="?attr/primaryColor"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnGrantUsage"
            style="@style/TextSmallBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Grant Usage Permission"
            android:textColor="?attr/primaryColor"
            android:textSize="12sp" />

    </LinearLayout>

    <EditText
        android:id="@+id/etSearchApp"
        style="@style/TextSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/rounded_rect_shade_color"
        android:hint="Search apps..."
        android:padding="12dp"
        android:textColor="?attr/primaryColor"
        android:textColorHint="?attr/primaryColorTrans80" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAppsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp" />

</LinearLayout>
