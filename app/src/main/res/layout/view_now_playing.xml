<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nowPlayingContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Wavy line progress bar going across the screen -->
    <app.olauncher.media.WavyProgressBar
        android:id="@+id/wavyProgressBar"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginBottom="10dp" />

    <!-- Card Row: 72dp Cover + Track Info + Playback Controls -->
    <LinearLayout
        android:id="@+id/nowPlayingRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 72dp cover with rounded corners -->
        <FrameLayout
            android:id="@+id/coverContainer"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:clickable="false"
            android:focusable="false">

            <ImageView
                android:id="@+id/ivCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/ivCoverIncoming"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Track info: Title and Artist -->
        <LinearLayout
            android:id="@+id/textContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:clickable="false"
            android:focusable="false"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSongTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:ellipsize="end"
                android:focusable="false"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/ol_text_primary"
                android:textSize="16sp"
                tools:text="Song Title" />

            <TextView
                android:id="@+id/tvArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:clickable="false"
                android:ellipsize="end"
                android:focusable="false"
                android:fontFamily="sans-serif-light"
                android:maxLines="1"
                android:textColor="@color/ol_text_secondary"
                android:textSize="13sp"
                tools:text="Artist Name" />

        </LinearLayout>

        <!-- Playback Controls: Previous, Play/Pause, Next -->
        <LinearLayout
            android:id="@+id/controlsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnPrevious"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Previous"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_skip_previous"
                app:tint="@color/ol_text_primary" />

            <ImageView
                android:id="@+id/btnPlayPause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Play or Pause"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_pause"
                app:tint="@color/ol_text_primary" />

            <ImageView
                android:id="@+id/btnNext"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Next"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_skip_next"
                app:tint="@color/ol_text_primary" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
